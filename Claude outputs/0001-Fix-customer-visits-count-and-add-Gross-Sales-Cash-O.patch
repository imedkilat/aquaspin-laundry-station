+-- non-deleted transaction row, including cancelled ones. A customer who
+-- dropped off two loads on the same day showed as "2 visits", and a
+-- cancelled order still counted as a visit. Eddy asked for visits to track
+-- distinct days the customer actually came in, matching how a laundry shop
+-- thinks about "a visit".
+--
+-- total_billed / total_collected / outstanding_balance are intentionally
+-- left untouched by this migration - those are money fields, not visit
+-- counts, and changing what counts as "billed"/"collected" for cancelled
+-- orders is a separate decision outside what was asked here.
+begin;
+set local lock_timeout = '5s';
+
+drop view if exists public.customer_summary;
+create view public.customer_summary with (security_invoker = true) as
+select c.id as customer_id, c.customer_code,
+  count(distinct t.transaction_date) filter (where t.order_status <> 'cancelled') as total_transactions,
+  coalesce(sum(t.total_amount), 0) as total_billed,
+  coalesce(sum(least(t.total_amount, coalesce(t.cash_amount, 0) + coalesce(t.gcash_amount, 0))), 0) as total_collected,
+  coalesce(sum(greatest(t.total_amount - least(t.total_amount, coalesce(t.cash_amount, 0) + coalesce(t.gcash_amount, 0)), 0)), 0) as outstanding_balance,
+  max(t.transaction_date) filter (where t.order_status <> 'cancelled') as last_visit
+from public.customers c
+left join public.transactions t on t.customer_id = c.id and t.deleted_at is null
+group by c.id, c.customer_code;
+
+revoke all on public.customer_summary from public, anon, authenticated;
+grant select on public.customer_summary to authenticated;
+
+commit;
